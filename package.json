{
  "name": "ssms-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "typecheck:docs-worker": "tsc -p docs-worker",
    "test:docs-worker": "vitest run --config docs-worker/vitest.config.ts",
    "typecheck:worker": "tsc -p worker",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview:cf": "npm run build && wrangler dev"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "pdfjs-dist": "6.4.299",
    "posthog-js": "^1.438.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-rnd": "10.5.3",
    "react-router-dom": "^6.26.2",
    "signature_pad": "5.1.4",
    "tailwind-merge": "2.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@eslint/js": "^9.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "jsdom": "30.1.2",
    "msw": "^2.4.9",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "^4.135.0"
  }
}
