# SSMS Portal — environment

# Base URL of the NestJS API (ssms-api). The API must allow-list this app's
# origin via CORS_ALLOWED_ORIGINS for browser calls to succeed.
VITE_API_BASE_URL=http://localhost:3000

# Supabase project (publishable key is safe for the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
