# SSMS Portal — PRODUCTION environment
#
# Copy to .env.production and fill in:
#   cp .env.production.example .env.production
#
# Vite loads this automatically for `npm run build` (mode=production).
#
# ⚠️ These values are BAKED INTO THE BUNDLE at build time. Changing them
# requires a full rebuild + redeploy, not a restart. Never put a secret here —
# only the publishable key belongs in a browser bundle.
#
# In Cloudflare Pages these same three vars are set in the dashboard
# (Settings → Environment variables → Production). This file is for local
# production-parity builds (`npm run build && npm run preview`).

# Deployed API origin. No trailing slash.
VITE_API_BASE_URL=https://api.<domain>

# Production Supabase project — NOT the dev one.
VITE_SUPABASE_URL=https://<prod-ref>.supabase.co

# Publishable key (`sb_publishable_...`) from the PRODUCTION project.
VITE_SUPABASE_PUBLISHABLE_KEY=
