# SSMS Portal — DEVELOPMENT environment
#
# Copy to .env.development and fill in:
#   cp .env.development.example .env.development
#
# Vite loads this automatically for `npm run dev` (mode=development).
# You do NOT need to pass --mode.

# Base URL of the local NestJS API (ssms-api).
# The API must allow-list this app's origin via CORS_ALLOWED_ORIGINS
# (set CORS_ALLOWED_ORIGINS=http://localhost:5173 in ssms-api/.env.dev).
VITE_API_BASE_URL=http://localhost:3000

# Dev Supabase project. Must be the SAME project as ssms-api/.env.dev,
# or login will succeed against one project while the API reads another.
VITE_SUPABASE_URL=https://pyoghssleatymfmikrgx.supabase.co

# Publishable key (`sb_publishable_...`) — safe for the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=
